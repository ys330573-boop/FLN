    "audio_text": {
      "cap_landing": "नमस्ते दोस्त! मैं हूँ स्विफ्टी। आइए, देखते और सीखते हैं कि कौन-से बर्तन में कितना पानी है।",
      "cap_pt_tutorial": "ध्यान से देखिए और मेरे साथ जानिए। चलिए, शुरू करें!",
      "cap_pt_guided": "बहुत बढ़िया! अब हम साथ मिलकर शुरू करते हैं। चलिए, साथ में करें!",
      "cap_pt_practice": "वाह! अब आपकी बारी।",
      "cap_p2_q": "यहाँ एक गिलास और एक मग दिया हुआ है। इनमें से ज़्यादा पानी किसमें आएगा? सही बर्तन पर टैप करिए।",
      "cap_p2_idle": "ज़्यादा पानी वाले बर्तन पर टैप करिए।",
      "cap_p2_ok": "शाबाश! गिलास और मग में से, मग में पानी की मात्रा ज़्यादा होगी।",
      "cap_p2_wrong": "गिलास में पानी कम आएगा, और मग में ज़्यादा। इसलिए सही बर्तन मग है।",
      "cap_p3_t": "ध्यान रहें। मात्रा मापने के लिए हम हमेशा एक जैसे बर्तनों का उपयोग करते है।",
      "cap_p4_a": "यहाँ एक खाली बोतल और चार एक जैसे दूध के गिलास हैं। दूध को बोतल में डालकर देखते हैं, यह कितने गिलास से भरती है।",
      "cap_p4_b": "यह बोतल चार गिलास से पूरी भर गई। इस बोतल की मात्रा चार गिलास के बराबर है।",
      "cap_p5_a": "यह जग पानी से पूरा भरा हुआ है। इसका सारा पानी गिलासों में डालकर देखते हैं कि कितने गिलास भरते हैं।",
      "cap_p5_b": "इस जग से चार गिलास पूरे भर गए। इसकी मात्रा चार गिलास के बराबर है।",
      "cap_p7_a": "यह जार तेल से पूरा भरा हुआ है। इस जार का पूरा तेल इन कपों में भरिए।",
      "cap_p7_b": "अब आप बचा हुआ तेल बाकी कपों में डालिए।",
      "cap_p7_q": "इस जार में कितने कप तेल है? सही संख्या चुनिए।",
      "cap_p7_ok": "शाबाश! जार से चार कप भर गए।",
      "cap_p7_h1": "फिर से गिनिए।",
      "cap_p7_h2": "एक, दो, तीन, चार। कुल चार कप भरे हुए हैं।",
      "cap_p7_h3": "सही संख्या यह है।",
      "cap_p8_a": "दूध डालकर देखिए, यह जार कितने कप से भरता है।",
      "cap_p8_b": "अब बाकी कपों का दूध जार में डालिए।",
      "cap_p8_q": "यह जार कितने कप दूध से भरा? सही संख्या चुनिए।",
      "cap_p8_ok": "शाबाश! यह जार आठ कप दूध से पूरा भर गया।",
      "cap_p8_h1": "फिर से गिनिए।",
      "cap_p8_h2": "एक, दो, तीन, चार, पाँच, छह, सात, आठ। कुल आठ कप खाली हुए हैं।",
      "cap_p8_h3": "सही संख्या यह है।",
      "cap_p9_a": "बोतल का पूरा पानी गिलासों में भरने के लिए बोतल पर टैप करिए।",
      "cap_p9_q": "बोतल में कितने गिलास पानी है? सही संख्या चुनिए।",
      "cap_p9_ok": "शाबाश! इस बोतल में तीन गिलास पानी है।",
      "cap_p9_h1": "फिर से गिनिए।",
      "cap_p9_h2": "एक, दो, तीन। कुल तीन गिलास भरे हैं।",
      "cap_p9_h3": "सही संख्या यह है।",
      "cap_p10_a": "इन मगों का सारा तेल जग में डालिए।",
      "cap_p10_q": "यह जग कितने मग तेल से भर गया? सही संख्या चुनिए।",
      "cap_p10_ok": "शाबाश! यह जग छह मग से भर गया।",
      "cap_p10_h1": "फिर से गिनिए।",
      "cap_p10_h2": "एक, दो, तीन, चार, पाँच, छह। कुल छह मग खाली हुए हैं।",
      "cap_p10_h3": "सही संख्या यह है।",
      "cap_p11_a": "सुबह का समय है। गाँव में दूधवाले की दुकान खुल गई है। तभी कुछ लोग दूध लेने दुकान पर आते हैं।",
      "cap_p11_c1": "मुझे चार गिलास दूध चाहिए।",
      "cap_p11_c2": "मुझे दो गिलास दूध चाहिए।",
      "cap_p11_c3": "मुझे तीन गिलास दूध चाहिए।",
      "cap_p11_b": "तीनों बर्तनों पर एक-एक करके टैप करिए और इनकी मात्रा मापिए।",
      "cap_p11_tap": "गिलासों पर टैप करके दूध बोतल में डालिए।",
      "cap_p11_m_small": "यह वाली बोतल दो गिलास दूध से भर गई।",
      "cap_p11_m_mid": "यह वाली बोतल तीन गिलास दूध से भर गई।",
      "cap_p11_m_big": "यह बोतल चार गिलास दूध से भर गई।",
      "cap_p11_q": "भरी बोतल को सही ग्राहक तक खींचकर ले जाइए।",
      "cap_p11_ok": "शाबाश! सभी को सही बोतल मिल गई।",
      "cap_p11_w1": "फिर से सोचिए। बोतल में कितने गिलास दूध है और किसे उतना चाहिए?",
      "cap_p11_w2_2": "इसमें दो गिलास दूध है, इसे दो गिलास वाले ग्राहक को दीजिए।",
      "cap_p11_w2_3": "इसमें तीन गिलास दूध है, इसे तीन गिलास वाले ग्राहक को दीजिए।",
      "cap_p11_w2_4": "इसमें चार गिलास दूध है, इसे चार गिलास वाले ग्राहक को दीजिए।",
      "cap_p11_w3": "यह बोतल इन्हें दीजिए।",
      "cap_p11_t1": "धन्यवाद!",
      "cap_p11_t2": "धन्यवाद!",
      "cap_p11_t3": "धन्यवाद!",
      "cap_well_done": "शाबाश! आपने सीख लिया है कि बर्तन की मात्रा कितनी है।",
      "cap_p2_ok2": "गिलास और मग में से, मग में पानी की मात्रा ज़्यादा होगी।",
      "cap_p7_ok2": "जार से चार कप भर गए।",
      "cap_p8_ok2": "यह जार आठ कप दूध से पूरा भर गया।",
      "cap_p9_ok2": "इस बोतल में तीन गिलास पानी है।",
      "cap_p10_ok2": "यह जग छह मग से भर गया।",
      "cap_p11_ok2": "सभी को सही बोतल मिल गई।",
      "cap_num_1": "एक",
      "cap_num_2": "दो",
      "cap_num_3": "तीन",
      "cap_num_4": "चार",
      "cap_num_5": "पाँच",
      "cap_num_6": "छह",
      "cap_num_7": "सात",
      "cap_num_8": "आठ",
      "cap_num_9": "नौ",
      "cap_num_10": "दस"
    },
