    "audio_text": {
      "cap_landing": "नमस्ते दोस्त! मैं हूँ स्विफ्टी। आइए, देखते और सीखते हैं कि कौन-से बर्तन में कितना पानी है।",
      "cap_pt_tutorial": "ध्यान से देखिए और मेरे साथ जानिए। चलिए, शुरू करें!",
      "cap_pt_guided": "बहुत बढ़िया! अब हम साथ मिलकर शुरू करते हैं। चलिए, साथ में करें!",
      "cap_pt_practice": "वाह! अब आपकी बारी।",
      "cap_p2_q": "यहाँ एक गिलास और एक मग दिया हुआ है। इन दोनों में ज़्यादा पानी किसमें आएगा, गिलास में या मग में? सही बर्तन पर टैप करिए।",
      "cap_p2_idle": "ज़्यादा पानी किसमें आएगा, गिलास में या मग में? सही बर्तन पर टैप करिए।",
      "cap_p2_ok": "शाबाश! गिलास और मग में से, मग में पानी की मात्रा ज़्यादा होगी।",
      "cap_p2_wrong": "गिलास में पानी कम आएगा, और मग में ज़्यादा। इसलिए सही बर्तन मग है।",
      "cap_p3_a": "यहाँ हम सीखेंगे कि जब किसी बड़े बर्तन में पानी या किसी चीज़ की मात्रा मापनी हो, तो छोटे बर्तनों का सही उपयोग कैसे किया जाता है। यहाँ दो अलग-अलग तरीके दिए गए हैं। एक जगह तीन कप हैं, और दूसरी जगह दो कप और एक गिलास है।",
      "cap_p3_b": "जब भी हम किसी बर्तन में पानी या किसी चीज़ की मात्रा को मापते हैं, तो मापने के लिए इस्तेमाल होने वाले बर्तन एक जैसे होने चाहिए। वरना हम मात्रा को सही तरीके से नहीं माप सकेंगे। इसलिए सही तरीका यह है, जिसमें सभी बर्तन एक जैसे हों।",
      "cap_p4_a": "अब हम सीखते हैं, इस बोतल में दूध की मात्रा कितने गिलास है? यहाँ एक बोतल पूरी खाली है, और चार एक जैसे गिलास में दूध है। इन गिलासों का सारा दूध एक-एक करके बोतल में डालते हैं, और देखते हैं कि यह बोतल कितने गिलास से भरती है।",
      "cap_p4_b": "यह बोतल चार गिलास से पूरी भर गई। तो इस बोतल में दूध की मात्रा चार एक जैसे गिलास के बराबर है।",
      "cap_p5_a": "अब हम सीखते हैं, जग में पानी की मात्रा कितने गिलास है? यहाँ एक जग में पूरा पानी भरा हुआ है। इसका सारा पानी इन गिलासों में भरते हैं, और देखते हैं, कितने गिलास भरते हैं।",
      "cap_p5_b": "यहाँ एक जग से चार गिलास पूरे भर गए। तो जग में पानी की मात्रा चार गिलास के बराबर है।",
      "cap_p7_a": "यहाँ एक जार, तेल से पूरा भरा हुआ है, और कुछ एक जैसे खाली कप रखे हुए हैं। जार को ऐसे ले जाकर इन कपों को तेल से पूरा भरिए।",
      "cap_p7_b": "अब आप करिए। जार में बचा हुआ तेल इन बचे हुए कपों में डालिए।",
      "cap_p7_q": "इस जार में कितने कप तेल है? सही संख्या पर टैप करिए।",
      "cap_p7_ok": "शाबाश! इस जार से चार कप पूरे भर गए।",
      "cap_p7_h1": "दोबारा गिनिए कि कितने कप पूरे भरे हैं।",
      "cap_p7_h2": "एक, दो, तीन, चार। कुल चार कप भरे हैं। सही संख्या यह है।",
      "cap_p8_a": "यहाँ दस कप दूध से पूरे भरे हुए हैं, और एक छोटा भगोना पूरा खाली है। कपों का दूध एक-एक करके भगोने में डालिए, और देखिए कि भगोना कितने कप से भरता है।",
      "cap_p8_b": "अब आप करिए। बचे हुए कपों का दूध भगोने में डालिए।",
      "cap_p8_q": "यह भगोना कितने कप दूध से पूरा भर गया? सही संख्या पर टैप करिए।",
      "cap_p8_ok": "शाबाश! यह भगोना आठ कप दूध से पूरा भर गया।",
      "cap_p8_h1": "दोबारा गिनिए कि कितने कप खाली हुए हैं।",
      "cap_p8_h2": "एक, दो, तीन, चार, पाँच, छह, सात, आठ। कुल आठ कप खाली हुए हैं। सही संख्या यह है।",
      "cap_p9_a": "यहाँ एक बोतल पानी से पूरी भरी हुई है, और चार खाली गिलास रखे हुए हैं। बोतल में कितने गिलास पानी की मात्रा है, यह जानने के लिए बोतल से सारा पानी इन खाली गिलासों में डालना होगा। अब बोतल पर टैप करिए।",
      "cap_p9_q": "इस बोतल में पानी की मात्रा कितने गिलास के बराबर है? सही संख्या पर टैप करिए।",
      "cap_p9_ok": "शाबाश! इस बोतल में पानी की मात्रा कुल तीन गिलास के बराबर है।",
      "cap_p9_h1": "दोबारा देखिए कि कितने गिलास पूरे भरे हैं।",
      "cap_p9_h2": "एक, दो, तीन। कुल तीन गिलास भरे हैं। सही संख्या यह है।",
      "cap_p10_a": "यहाँ एक खाली जग है, और छह छोटे मग हैं, जो तेल से पूरे भरे हुए हैं। मगों का तेल एक-एक करके जग में डालिए, और देखिए कितने मग से यह जग पूरा भरता है।",
      "cap_p10_q": "यह जग कितने मग तेल से पूरा भरा है? सही संख्या पर टैप करिए।",
      "cap_p10_ok": "शाबाश! यह जग छह मग तेल से पूरा भर गया।",
      "cap_p10_h1": "दोबारा गिनिए कि कितने मग खाली हुए हैं।",
      "cap_p10_h2": "एक, दो, तीन, चार, पाँच, छह। कुल छह मग खाली हुए हैं। सही संख्या यह है।",
      "cap_p11_a": "सुबह का समय है। गाँव में दूधवाले की दुकान खुल गई है। तभी तीन लोग दूध लेने दुकान पर आते हैं।",
      "cap_p11_c1": "मुझे चार गिलास दूध चाहिए।",
      "cap_p11_c2": "मुझे दो गिलास दूध चाहिए।",
      "cap_p11_c3": "मुझे तीन गिलास दूध चाहिए।",
      "cap_p11_b": "यहाँ तीनों बर्तनों पर एक-एक करके टैप करिए, और फिर इनकी मात्रा मापते हैं।",
      "cap_p11_tap": "अब दूध के गिलासों पर एक-एक करके टैप करिए, और दूध को बोतल में डालिए।",
      "cap_p11_m_small": "यह छोटी बोतल दो गिलास दूध से भर गई।",
      "cap_p11_m_mid": "यह बीच वाली बोतल तीन गिलास दूध से भर गई।",
      "cap_p11_m_big": "यह बड़ी बोतल चार गिलास दूध से भर गई।",
      "cap_p11_q": "अब भरी हुई बोतलों को खींचकर उस ग्राहक तक ले जाइए, जिसे उतना दूध चाहिए।",
      "cap_p11_ok": "शाबाश! सभी ग्राहकों को सही बोतल मिल गई।",
      "cap_p11_w1": "दोबारा सोचिए। इस बोतल में कितने गिलास दूध है, और किसे उतना दूध चाहिए?",
      "cap_p11_w2_2": "इस बोतल में दो गिलास दूध है। यह उन्हें दीजिए, जिन्हें दो गिलास दूध चाहिए।",
      "cap_p11_w2_3": "इस बोतल में तीन गिलास दूध है। यह उन्हें दीजिए, जिन्हें तीन गिलास दूध चाहिए।",
      "cap_p11_w2_4": "इस बोतल में चार गिलास दूध है। यह उन्हें दीजिए, जिन्हें चार गिलास दूध चाहिए।",
      "cap_p11_t1": "धन्यवाद!",
      "cap_p11_t2": "धन्यवाद!",
      "cap_p11_t3": "धन्यवाद!",
      "cap_well_done": "शाबाश! आपने सीख लिया है कि बर्तन की मात्रा कितनी है।",
      "cap_p2_ok2": "गिलास और मग में से, मग में पानी की मात्रा ज़्यादा होगी।",
      "cap_p7_ok2": "इस जार से चार कप पूरे भर गए।",
      "cap_p8_ok2": "यह भगोना आठ कप दूध से पूरा भर गया।",
      "cap_p9_ok2": "इस बोतल में पानी की मात्रा कुल तीन गिलास के बराबर है।",
      "cap_p10_ok2": "यह जग छह मग तेल से पूरा भर गया।",
      "cap_p11_ok2": "सभी ग्राहकों को सही बोतल मिल गई।",
      "cap_num_1": "एक",
      "cap_num_2": "दो",
      "cap_num_3": "तीन",
      "cap_num_4": "चार",
      "cap_num_5": "पाँच",
      "cap_num_6": "छह",
      "cap_num_7": "सात",
      "cap_num_8": "आठ",
      "cap_num_9": "नौ",
      "cap_num_10": "दस"
    },
